# Optional override. The call-conversion label already ships hardcoded in
# google-ads-tag.tsx; only set this to point at a different conversion action.
# Use only the label portion shown after AW-17537368439/ in Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=

# Server-only Resend credentials. Use a verified domain for the sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Wil & Co. Painting <quotes@wilandcopainting.com>"
CONTACT_TO_EMAIL=wilandcopainting@gmail.com
# Temporary copy during testing. Set to an empty value to disable it.
CONTACT_CC_EMAIL=info@cluster.marketing
